# ============================================================
# Environment Configuration — copy to .env and fill in values
# ============================================================

# PostgreSQL connection
DATABASE_URL=postgresql://bi_user:bi_password@localhost:5432/bi_db

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Mock API (internal service)
MOCK_API_URL=http://localhost:8001

# Scheduler — interval in minutes between automatic pipeline runs (0 = disabled)
SCHEDULER_INTERVAL_MINUTES=60

# Optional: Google Sheets (leave blank to disable)
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_TOKEN_FILE=

# Optional: Shopify (leave blank to disable)
SHOPIFY_SHOP_NAME=
SHOPIFY_ACCESS_TOKEN=

# ============================================================
# Person 3: AI Business Intelligence Agent
# ============================================================
# Leave API keys empty to use the built-in deterministic reasoning engine,
# or provide an API key to enable LLM-augmented reasoning.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_AGENT_MODEL=built-in-analyst

